# ============================================================================
# MARMITA CONNECT (VERDE&MESA) — VARIÁVEIS DE AMBIENTE (INFRAESTRUTURA PRÓPRIA)
# Copie para .env e preencha com as credenciais das suas próprias contas.
# NUNCA faça commit do arquivo .env com chaves reais.
# ============================================================================

# 1. SUPABASE PRÓPRIO (Cliente + Servidor)
VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="sua_chave_anon_ou_publishable_aqui"

SUPABASE_URL="https://SEU_PROJETO.supabase.co"
SUPABASE_ANON_KEY="sua_chave_anon_ou_publishable_aqui"
# Chave secreta EXCLUSIVA de backend (NUNCA expor com prefixo VITE_)
SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key_secreta_aqui"

# 2. BANCO DE DADOS POSTGRESQL (Para Drizzle / Migrações / Backup / Homologação)
DATABASE_URL="postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres"
STAGING_DATABASE_URL="postgresql://postgres:SUA_SENHA@db.SEU_PROJETO_STAGING.supabase.co:5432/postgres"
RESTORE_TEST_DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:54332/marmita_restore_drill"
PRODUCTION_PROJECT_REF="ref_do_projeto_producao"
STAGING_PROJECT_REF="ref_do_projeto_staging"

# 3. GOOGLE GEMINI API DIRETA (Exclusiva de backend)
GEMINI_API_KEY="sua_chave_google_ai_studio_gemini_aqui"

# 4. META WHATSAPP CLOUD API (Exclusivas de backend)
WHATSAPP_APP_SECRET="seu_meta_app_secret_para_hmac_sha256"
WHATSAPP_VERIFY_TOKEN="seu_token_de_verificacao_do_webhook"
WHATSAPP_ACCESS_TOKEN="seu_token_permanente_system_user_meta"

# 5. WORKER DE FILA DURÁVEL, AGENDADOR (CRON) E RETENÇÃO LGPD
CRON_SECRET="gere_um_segredo_aleatorio_de_32_bytes"
CRON_SECRET_PREVIOUS=""
WHATSAPP_WEBHOOK_INLINE_BUDGET_MS="1200"
WHATSAPP_WEBHOOK_RATE_LIMIT_PER_MIN="120"
WHATSAPP_WEBHOOK_MAX_AGE_SECONDS="604800"
LGPD_RETENTION_DAYS="180"

# 6. POLÍTICA FAIL-CLOSED DE CONFIANÇA EM CABEÇALHOS DE IP DO WEBHOOK (AF-05)
# Na Vercel (onde VERCEL="1" / VERCEL_ENV é injetado automaticamente pela plataforma),
# x-vercel-forwarded-for é validado por padrão. Fora da Vercel, TODOS os cabeçalhos de proxy
# permanecem DESABILITADOS por padrão ("false") e só são aceitos se explicitamente habilitados:
TRUST_VERCEL_FORWARDED_FOR="false"
TRUST_CLOUDFLARE_IP="false"
TRUST_X_REAL_IP="false"
TRUST_PROXY_XFF="false"

# 7. ALERTAS OPERACIONAIS (Webhook opcional para Slack / Discord / PagerDuty)
OPERATIONAL_ALERT_WEBHOOK_URL=""
